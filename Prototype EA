                        <div class="text-xs font-bold text-gray-600 uppercase tracking-wider mt-1">Ervaring in Logistiek</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-orange-50/50 border border-orange-100">
                        <div class="text-3xl sm:text-4xl font-black text-brand-500">1.550</div>
                        <div class="text-xs font-bold text-gray-600 uppercase tracking-wider mt-1">Ritten Per Jaar</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-orange-50/50 border border-orange-100">
                        <div class="text-3xl sm:text-4xl font-black text-brand-500">7.500</div>
                        <div class="text-xs font-bold text-gray-600 uppercase tracking-wider mt-1">Zendingen Verwerkt</div>
