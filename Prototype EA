                <!-- Track Result Display Box -->
                <div id="track-result" class="hidden mt-8 max-w-2xl mx-auto bg-white text-gray-800 rounded-2xl p-6 text-left shadow-2xl transition-all"></div>
            </div>
        </section>

        <!-- Stats Counter Bar -->
        <section id="feiten" class="py-12 bg-white border-b border-orange-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
                    <div class="p-4 rounded-2xl bg-orange-50/50 border border-orange-100">
