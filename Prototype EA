                <p class="mt-4 text-lg sm:text-xl text-orange-100 max-w-2xl mx-auto font-medium">
                    Dé specialist voor dagelijkse snelkoeriersritten, ziekenhuiszendingen (CryoPDP) en internationaal transport onder leiding van Winston Grot.
                </p>

                <!-- Track & Trace Search Card -->
                <div id="track" class="mt-10 max-w-2xl mx-auto bg-white/10 backdrop-blur-md p-3 sm:p-4 rounded-2xl border border-white/20 shadow-2xl">
                    <form onsubmit="handleTrack(event)" class="flex flex-col sm:flex-row gap-3">
                        <div class="relative flex-grow">
                            <i class="fa-solid fa-barcode absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg"></i>
                            <input type="text" id="tracking-number" placeholder="Voer zendingsnummer in (bijv. EA-1029)" required
                                class="w-full pl-11 pr-4 py-3.5 bg-white text-gray-900 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 shadow-inner font-medium">
                        </div>
                        <button type="submit" class="bg-white hover:bg-orange-50 text-brand-600 font-bold px-8 py-3.5 rounded-xl transition-all shadow-lg flex items-center justify-center gap-2">
                            <i class="fa-solid fa-magnifying-glass text-sm"></i>
                            <span>Zoeken</span>
                        </button>
                    </form>
                    <p class="text-xs text-orange-100 mt-2 text-left px-2">Gebruik testcode <button type="button" onclick="fillTestCode()" class="underline font-bold hover:text-white">EA-1029</button></p>
