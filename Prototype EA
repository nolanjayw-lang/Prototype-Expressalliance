                        <div class="text-xs font-bold text-gray-600 uppercase tracking-wider mt-1">Telefonische Spoedservice</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="diensten" class="py-20 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <h2 class="text-xs font-extrabold uppercase tracking-widest text-brand-500">Onze Logistieke Diensten</h2>
                    <p class="text-3xl font-black text-gray-900 mt-2">Herkenbaar op de weg: "We like to move it"</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Service 1 -->
                    <div class="bg-white rounded-2xl p-8 border border-orange-100 hover:shadow-xl transition-all hover:-translate-y-1 group">
                        <div class="w-14 h-14 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-brand-500 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-van-shuttle"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Nationale Snelkoerier</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-4">
                            Directe bezorging van pakketten en documenten van A naar B door heel Nederland en Europa. Geen vertragingen of overladen.
                        </p>
                    </div>

                    <!-- Service 2 -->
                    <div class="bg-white rounded-2xl p-8 border border-orange-100 hover:shadow-xl transition-all hover:-translate-y-1 group">
                        <div class="w-14 h-14 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-brand-500 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-hospital"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Medisch & CryoPDP Transport</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-4">
                            Gespecialiseerde ziekenhuiszendingen wereldwijd met strikte temperatuurbewaking en gecontroleerde afhandeling.
                        </p>
                    </div>

                    <!-- Service 3 -->
                    <div class="bg-white rounded-2xl p-8 border border-orange-100 hover:shadow-xl transition-all hover:-translate-y-1 group">
                        <div class="w-14 h-14 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-brand-500 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-earth-americas"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Internationale Zendingen</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-4">
                            Sterke logistieke routes voor klanten uit Nederland, Engeland en wereldwijde eindbestemmingen.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ABOUT US SECTION (Over Ons) -->
        <section id="feiten" class="py-20 bg-white border-t border-orange-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    
                    <!-- Left Column: Story -->
                    <div class="space-y-6">
                        <span class="inline-block bg-brand-100 text-brand-700 font-bold text-xs uppercase tracking-widest px-3.5 py-1.5 rounded-full">
                            Over Express Alliance
                        </span>
                        <h2 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight">
                            Al 25 jaar gedreven door passie voor <span class="text-brand-500">snelheid & precisie</span>.
                        </h2>
                        <p class="text-gray-600 text-sm leading-relaxed">
                            Onder leiding van eigenaar <strong>Winston Grot</strong> is Express Alliance uitgegroeid tot een gevestigde naam in de logistieke wereld. Met gemiddeld <strong>1.550 ritten</strong> en ruim <strong>7.500 zorgvuldig verwerkte zendingen per jaar</strong>, zorgen wij dagelijks dat kostbare en tijdkritische goederen veilig hun bestemming bereiken.
                        </p>
                        <p class="text-gray-600 text-sm leading-relaxed">
                            Of het nu gaat om een spoedrit tussen Nederlandse steden of geconditioneerde ziekenhuiszendingen (zoals CryoPDP) met wereldwijde eindbestemmingen: onze opvallende bestelbussen en dedicated koeriers staan klaar met ons motto: <strong class="text-brand-600 italic">"We like to move it!"</strong>
                        </p>

                        <!-- Key Highlights -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                            <div class="flex items-center gap-3 p-3.5 rounded-xl bg-orange-50/60 border border-orange-100">
                                <div class="w-9 h-9 rounded-lg bg-brand-500 text-white flex items-center justify-center font-bold text-sm">
                                    <i class="fa-solid fa-clock"></i>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-gray-900">24/7 Bereikbaar</h4>
                                    <p class="text-[11px] text-gray-500">Direct persoonlijk contact</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3 p-3.5 rounded-xl bg-orange-50/60 border border-orange-100">
                                <div class="w-9 h-9 rounded-lg bg-brand-500 text-white flex items-center justify-center font-bold text-sm">
                                    <i class="fa-solid fa-temperature-arrow-down"></i>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-gray-900">Medisch Expert</h4>
                                    <p class="text-[11px] text-gray-500">IATA & CryoPDP regels</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Visual Card / Quote -->
                    <div class="relative">
                        <div class="bg-gradient-to-br from-brand-500 to-orange-700 text-white rounded-3xl p-8 sm:p-10 shadow-xl relative overflow-hidden">
                            <div class="absolute -right-8 -bottom-8 opacity-10 text-9xl font-black pointer-events-none">EA</div>
                            <span class="text-xs font-extrabold uppercase tracking-widest text-orange-200">Onze Visie</span>
                            <blockquote class="text-xl font-bold mt-4 mb-6 leading-snug">
                                "Logistiek draait niet alleen om het verplaatsen van dozen, maar om het nakomen van beloftes en het bieden van 100% zekerheid bij elke rit."
                            </blockquote>
                            <div class="flex items-center gap-4 pt-4 border-t border-white/20">
                                <div class="w-12 h-12 bg-white text-brand-600 rounded-full flex items-center justify-center font-black text-lg shadow-md">
                                    WG
                                </div>
                                <div>
                                    <h4 class="font-black text-sm">Winston Grot</h4>
                                    <p class="text-xs text-orange-200">Eigenaar & Directeur Express Alliance B.V.</p>
                                </div>
