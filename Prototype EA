    <!-- JavaScript logic -->
    <script>
        document.getElementById('year').textContent = new Date().getFullYear();

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        function toggleFaq(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);
            content.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
        }

        function fillTestCode() {
            document.getElementById('tracking-number').value = 'EA-1029';
        }

        function handleTrack(e) {
            e.preventDefault();
            const input = document.getElementById('tracking-number').value.trim();
            const resultBox = document.getElementById('track-result');
            if (!input) return;

            resultBox.classList.remove('hidden');
            resultBox.innerHTML = `
                <div class="flex items-center justify-center py-6">
                    <i class="fa-solid fa-circle-notch fa-spin text-brand-500 text-2xl mr-3"></i>
                    <span class="text-sm font-medium text-gray-600">Zendingsgegevens ophalen voor <strong>${input}</strong>...</span>
                </div>
            `;

            setTimeout(() => {
                resultBox.innerHTML = `
                    <div class="border-b border-gray-100 pb-4 mb-4 flex justify-between items-start">
                        <div>
                            <span class="text-xs uppercase font-extrabold text-brand-500 tracking-wider">Status Zending</span>
                            <h4 class="text-xl font-black text-gray-900">${input.toUpperCase()}</h4>
                            <p class="text-xs text-gray-500">Express Alliance Koerier • Verwachte levering: Vandaag voor 17:00</p>
                        </div>
                        <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Onderweg
                        </span>
                    </div>
                    <p class="text-xs text-gray-600">Uw zending is geladen in de Express Alliance bestelbus en onderweg naar de eindbestemming.</p>
                `;
            }, 500);
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            const alert = document.getElementById('contact-alert');
            alert.className = "mt-4 p-4 rounded-xl text-sm font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block";
            alert.textContent = "Bedankt voor uw bericht! Winston Grot of het Express Alliance team neemt zo snel mogelijk contact op.";
            e.target.reset();
        }
    </script>
